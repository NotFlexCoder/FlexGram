{
  "name": "flexgram-cloudflare",
  "version": "1.0.0",
  "description": "File-based Telegram bot framework for Cloudflare Workers with a one-command multi-bot CLI",
  "type": "module",
  "license": "MIT",
  "author": "Flex Coder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotFlexCoder/FlexGram.git"
  },
  "keywords": [
    "telegram",
    "bot",
    "cloudflare-workers",
    "wrangler",
    "firebase",
    "framework"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:poll": "node scripts/dev.js --poll",
    "build": "node scripts/gen.js && wrangler deploy --dry-run --outdir dist --minify",
    "deploy": "node scripts/deploy.js",
    "update": "node scripts/deploy.js --update",
    "env": "node scripts/env.js",
    "bots": "node scripts/manage.js list",
    "bots:remove": "node scripts/manage.js remove",
    "repo": "node scripts/manage.js repo",
    "logs": "node scripts/manage.js logs",
    "webhook": "node scripts/webhook.js",
    "webhook:info": "node scripts/webhook.js info",
    "webhook:delete": "node scripts/webhook.js delete",
    "gen": "node scripts/gen.js",
    "types": "node scripts/types.js",
    "new": "node scripts/new.js",
    "login": "wrangler login"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
